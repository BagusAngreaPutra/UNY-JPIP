@article{Hiryanto_Wibawa_Rohadi_2016, title={Pengembangan model pelatihan kepemimpinan bagi organisasi kepemudaan di Daerah Istimewa Yogyakarta}, volume={8}, url={https://journal.uny.ac.id/index.php/jpip/article/view/8275}, DOI={10.21831/jpipfip.v8i2.8275}, abstractNote={Penelitian ini bertujuan untuk: 1) Merumuskan peta konsep tentang kebutuhan pelatihan&amp;lt;br /&amp;gt;kepemimpinan pengurus organisasi kepemudaan di Daerah Istimewa Yogyakarta; 2)&amp;lt;br /&amp;gt;Melakukan kegiatan pengembangan model pelatihan kepemimpinan pengurus organisasi&amp;lt;br /&amp;gt;kepemudaan di Daerah Istimewa Yogyakarta. Metode penelitian yang digunakan adalah&amp;lt;br /&amp;gt;Penelitian dan Pengembangan (R &amp;amp;amp; D) model Borg and Gall yang dimodifikasi. Hasil&amp;lt;br /&amp;gt;penelitian menunjukkan bahwa: 1) Kebutuhan pelatihan kepemimpinan pengurus&amp;lt;br /&amp;gt;organisasi kepemudaan di Daerah Istimewa Yogyakarta dapat dirumuskan sebagai&amp;lt;br /&amp;gt;berikut: 1. Kebutuhan Pelatihan Keorganisasian, 2. Kebutuhan Pelatihan Instruktur; 3.&amp;lt;br /&amp;gt;Pelatihan Kader Inti dan Instruktur. 2) Pengembangan model pelatihan kepemimpinan&amp;lt;br /&amp;gt;pengurus organisasi kepemudaan di Daerah Istimewa Yogyakarta dapat dirumuskan&amp;lt;br /&amp;gt;sebagai berikut: Model pelatihan diselenggarakan oleh organisasi kepemudaan mulai dari&amp;lt;br /&amp;gt;orientasi organisasi kepemudaan, Latihan Kepemimpinan Tingkat I, Suplemen 1, untuk&amp;lt;br /&amp;gt;organisasi kepemudaan tingkat kabupaten/kota. Sedangkan untuk tingkat propinsi terdiri&amp;lt;br /&amp;gt;dari Latihan Kepemimpinan Tingkat II, suplemen 2. Sedangkan untuk tingkat pusat,&amp;lt;br /&amp;gt;terdiri dari: Latihan Kepemimpinan Tingkat III, penyegaran, dan pelatihan instruktur&amp;lt;br /&amp;gt;dan pelatihan kader inti}, number={2}, journal={Jurnal Penelitian Ilmu Pendidikan}, author={Hiryanto, Hiryanto and Wibawa, Lutfi and Rohadi, Al Setya}, year={2016}, month={Mar.} }