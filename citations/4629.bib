@article{Hanum, Sisca Rahmadonna_2015, title={IMPLEMENTASI MODEL PEMBELAJARAN MULTIKULTURAL DI SEKOLAH DASAR PROPINSIDAERAHISTTMEWA YOGYAKARTA}, volume={3}, url={https://journal.uny.ac.id/index.php/jpip/article/view/4629}, DOI={10.21831/jpipfip.v0i0.4629}, abstractNote={&amp;lt;p&amp;gt;This research is aim to increase the children positive appreciation to the culturally differentiotion, as the based to increase the quality of teaching that give the safe, comfort and condusive situation to the children on the teaching and learning process. This research is the next application and development of the research result that success to develop the multicultural teaching and learning process in the elementary school student. The approach that is used in the whole research is research and development (R&amp;amp;amp;D). The subject of the research is class teacher of 4&amp;lt;sup&amp;gt;th&amp;lt;/sup&amp;gt; grade, the headmaster, the student, the elementary school committee, the official education in the Daerah Istimewa Yogyakarta province, that are choosed by purposive sampling. The data collection technique is questionnaire, observation, interview, and documentation study that support by the focus group discussion(FGD) and also the logbook. The data analysis is quantitative and qualitative descriptive.&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;The results of the study are: (1) the modul for the students as the teaching resource supplement in the multicultural teaching on grade 4&amp;lt;sup&amp;gt;th&amp;lt;/sup&amp;gt;; (2) teacher guidance on the multicultural teaching in the form of modul fot 4&amp;lt;sup&amp;gt;th&amp;lt;/sup&amp;gt; grade; (3) the increase of the teacher ability on the multicultural teaching, especially in the 4&amp;lt;sup&amp;gt;th&amp;lt;/sup&amp;gt; grade elementary school student; (4) the implementation of multiculture cultivation in the elementary school students.&amp;lt;/p&amp;gt; &amp;lt;strong&amp;gt;&amp;lt;em&amp;gt;Keywords: Multicultural Teaching, Teaching Model, Teaching Modul&amp;lt;/em&amp;gt;&amp;lt;/strong&amp;gt;}, number={1}, journal={Jurnal Penelitian Ilmu Pendidikan}, author={Hanum, Sisca Rahmadonna, Farida}, year={2015}, month={Jun.} }