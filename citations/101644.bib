@article{Elvina Susanti_Banu Setyo Adi_Karlina Wong Lieung_2026, title={Predicting parent satisfaction in rural primary schools: The roles of teacher competence and learning facilities}, volume={19}, url={https://journal.uny.ac.id/index.php/jpip/article/view/101644}, DOI={10.21831/jpip.v19i2.101644}, abstractNote={&amp;lt;p&amp;gt;Parent satisfaction is a crucial stakeholder indicator of school service quality. However, prior research has largely examined school-family collaboration, teacher competence, and learning environments in isolated analytical streams. This study investigates the simultaneous and relative contributions of teachers’ pedagogical competence, professional competence, and learning facilities to parent satisfaction within an underserved rural primary school context in Indonesia. A cross-sectional correlational survey was conducted in March 2026 using a census of 142 parents or guardians at a public primary school in Central Kalimantan. Data were collected using four-point Likert questionnaires and analyzed via multiple linear regression. The model was significant, &amp;lt;em&amp;gt;F (3, 138) = 75.540, p &amp;amp;lt; .001&amp;lt;/em&amp;gt;, and explained 62.2% of the variance in parent satisfaction (&amp;lt;em&amp;gt;R²&amp;lt;/em&amp;gt; = .622; adjusted &amp;lt;em&amp;gt;R²&amp;lt;/em&amp;gt; = .613). Pedagogical competence was the strongest predictor (&amp;lt;em&amp;gt;β&amp;lt;/em&amp;gt; = .556, &amp;lt;em&amp;gt;p&amp;lt;/em&amp;gt; &amp;amp;lt; .001), followed by learning facilities (&amp;lt;em&amp;gt;β&amp;lt;/em&amp;gt; = .208, &amp;lt;em&amp;gt;p&amp;lt;/em&amp;gt; = .001) and professional competence (&amp;lt;em&amp;gt;β&amp;lt;/em&amp;gt; = .207, &amp;lt;em&amp;gt;p&amp;lt;/em&amp;gt; = .001). These findings highlight that even in resource-limited settings, parents prioritize the observable instructional practices of teachers alongside the physical adequacy of the school. The study contributes an integrated, parent-centered model to the literature, offering practical implications for school leaders to prioritize pedagogical coaching and targeted infrastructure improvements to enhance stakeholder satisfaction.&amp;lt;/p&amp;gt;}, number={2}, journal={Jurnal Penelitian Ilmu Pendidikan}, author={Elvina Susanti and Banu Setyo Adi and Karlina Wong Lieung}, year={2026}, month={Oct.}, pages={187—198} }