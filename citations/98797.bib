@article{Assyarifah_Nadlir_2026, title={Harmonizing islamic values and artificial intelligence in the development of the madrasah ibtidaiyah curriculum}, volume={19}, url={https://journal.uny.ac.id/index.php/jpip/article/view/98797}, DOI={10.21831/jpip.v19i2.98797}, abstractNote={&amp;lt;p&amp;gt;This study highlights the main aspects of the research, including its objectives, methodology, findings, and contributions to the field of education. The rapid advancement of science and technology has brought significant changes to various aspects of human life. Despite the growing development of Artificial Intelligence (AI), there remains a gap in understanding how this technology can be harmonized with Islamic values within the Madrasah Ibtidaiyah (MI) curriculum. Therefore, this study aims to explore strategies for harmonizing Islamic values and Artificial Intelligence (AI) in MI curriculum development by formulating an ethical and substantive integration model. This research employed a descriptive qualitative approach. Data were collected through literature review and document analysis involving various references related to Islamic education and educational technology. The findings reveal that harmonization is structured upon three main pillars: ontological foundation (AI as a tool/&amp;lt;em&amp;gt;wasilah&amp;lt;/em&amp;gt;), axiological framework (AI ethics grounded in &amp;lt;em&amp;gt;akhlaqul karimah&amp;lt;/em&amp;gt;), and pedagogical implementation in the curriculum. The study contributes to the field of education by proposing a new theoretical framework for developing a madrasah curriculum that is adaptive to technological advancements while maintaining its Islamic identity. Furthermore, the findings suggest the necessity of AI literacy training for MI teachers that is grounded in the values of religious moderation.&amp;lt;/p&amp;gt;}, number={2}, journal={Jurnal Penelitian Ilmu Pendidikan}, author={Assyarifah, Hilmiyatul Abidah and Nadlir}, year={2026}, month={Oct.}, pages={177–186} }