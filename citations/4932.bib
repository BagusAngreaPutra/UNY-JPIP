@article{Purwaaktari_2015, title={Pengaruh model collaborative learning terhadap kemampuan pemecahan masalah matematika dan sikap sosial siswa kelas V SD Jarakan Sewon Bantul}, volume={8}, url={https://journal.uny.ac.id/index.php/jpip/article/view/4932}, DOI={10.21831/jpipfip.v8i1.4932}, abstractNote={Penelitian ini bertujuan untuk mendeskripsikan pengaruh model collaborative learning&amp;lt;br /&amp;gt;terhadap kemampuan pemecahan masalah Matematika dan sikap sosial siswa kelas V SD&amp;lt;br /&amp;gt;Jarakan. Penelitian ini merupakan penelitian quasi experiment dengan desain randomized&amp;lt;br /&amp;gt;pretest-postest control group design. Populasi dalam penelitian ini adalah seluruh kelas V&amp;lt;br /&amp;gt;SD Jarakan pada tahun pelajaran 2014/2015 yang terdiri dari empat kelas yaitu kelas 5a,&amp;lt;br /&amp;gt;5b, 5c, dan 5d. Sampel sejumlah tiga kelas (dua kelas sebagai kelompok eksperimen dan&amp;lt;br /&amp;gt;satu kelas sebagai kelompok kontrol) ditentukan melalui pengundian. Data dikumpulkan&amp;lt;br /&amp;gt;menggunakan tes dan angket. Validitas instrumen tes dan angket diperoleh dari expert&amp;lt;br /&amp;gt;judgement sedangkan estimasi reliabilitasnya diperoleh dengan menggunakan rumus&amp;lt;br /&amp;gt;Alpha Cronbach. Data dianalisis menggunakan uji t dan uji2 Hotelling’s dengan taraf&amp;lt;br /&amp;gt;signifikansi 5%. Hasil penelitian menunjukkan bahwa: (1) terdapat pengaruh positif dan&amp;lt;br /&amp;gt;signifikan penggunaan model collaborative learning terhadap kemampuan pemecahan&amp;lt;br /&amp;gt;masalah Matematika siswa, (2) terdapat pengaruh positif dan signifikan penggunaan&amp;lt;br /&amp;gt;model collaborative learning terhadap sikap sosial siswa, dan (3) terdapat pengaruh positif&amp;lt;br /&amp;gt;dan signifikan penggunaan model collaborative learning terhadap kemampuan pemecahan&amp;lt;br /&amp;gt;masalah Matematika dan sikap sosial siswa yang diteliti}, number={1}, journal={Jurnal Penelitian Ilmu Pendidikan}, author={Purwaaktari, Eni}, year={2015}, month={Aug.} }