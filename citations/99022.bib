@article{Hasan_Saputra_Santosa_2026, title={Efectiveness of problem-based learning classical guidance in reducing students’ instagram use guidance action research}, volume={19}, url={https://journal.uny.ac.id/index.php/jpip/article/view/99022}, DOI={10.21831/jpip.v19i2.99022}, abstractNote={&amp;lt;p&amp;gt;The development of digital technology has influenced adolescents’ social behavior patterns, including their use of social media platforms such as Instagram. Excessive use may negatively affect students’ learning concentration, social interactions, and self-control. This study aimed to implement a classical guidance service using the Problem-Based Learning (PBL) method to reduce the tendency of Instagram use among Grade X TKL 2 students of SMK Negeri 4 Semarang in the 2025/2026 academic year. This study employed Guidance and Counseling Action Research (PTBK), conducted in two cycles. Each cycle consisted of planning, action implementation, observation, and reflection stages as an effort to evaluate the service process. The participants were 30 students selected based on their high intensity of Instagram use. A Likert-scale instrument was utilized to measure the level of social media use tendency. The findings indicated a significant decrease in Instagram use intensity, from the moderate (87%) and high (10%) categories to the low category (70%) after two cycles of intervention. These results suggest that classical guidance services using the Problem-Based Learning approach effectively help students improve self-awareness, self-regulation, and time-management skills in relation to social media use. This approach may serve as an alternative basic Guidance and Counseling service strategy that is relevant to addressing students’ digital behavioral challenges in the modern era.&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;&amp;lt;strong&amp;gt;Keywords&amp;lt;/strong&amp;gt;&amp;lt;strong&amp;gt;:&amp;lt;/strong&amp;gt; Classical Guidance; Problem-Based Learning; Instagram Use&amp;lt;/p&amp;gt;}, number={2}, journal={Jurnal Penelitian Ilmu Pendidikan}, author={Hasan, Barkafik Ali and Saputra, Wahyu Nanda Eka and Santosa, Hardi}, year={2026}, month={Oct.}, pages={211—220} }