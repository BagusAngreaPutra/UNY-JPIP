@article{Kasmiatun_2020, title={Upaya meningkatkan minat belajar pelajaran seni budaya melalui model discovery learning dengan media puzzle}, volume={13}, url={https://journal.uny.ac.id/index.php/jpip/article/view/29984}, DOI={10.21831/jpipfip.v13i1.29984}, abstractNote={Best practice ini bertujuan untuk meningkatkan minat belajar siswa pelajaran seni budaya terhadap materi ragam hias pada bahan alam (kayu) menggunakan model discovery learning dengan media puzzle. Karya tulis ini menceritakan pengalaman terbaik guru dalam menyelesaikan sebuah permasalahan pembelajaran di kelasnya. Hasil analisis data nilai minat belajar siswa menunjukkan adanya peningkatan minat belajar siswa yaitu nilai persentase klasikal minat belajar siswa 89% dengan kategori 94% tinggi yang berdampak pada nilai hasil belajar siswa sehingga mengalami peningkatan dengan nilai rata-rata kelas 92% dan ketuntasan klasikal 87.5%. Kesimpulan best practice ini adalah bahwa penggunaan model discovery learning dengan media  puzzle dapat meningkatkan minat belajar siswa pelajaran seni budaya terhadap materi ragam hias pada bahan alam (kayu) di kelas VII A SMP Negeri 1 Teluk Bayur.}, number={1}, journal={Jurnal Penelitian Ilmu Pendidikan}, author={Kasmiatun, Kasmiatun}, year={2020}, month={Jun.}, pages={52–62} }