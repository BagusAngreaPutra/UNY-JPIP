@article{Prisuna_2020, title={Pengembangan media tes berbasis online pada Mata Pelajaran Fisika untuk sekolah menengah atas}, volume={13}, url={https://journal.uny.ac.id/index.php/jpip/article/view/30167}, DOI={10.21831/jpipfip.v13i1.30167}, abstractNote={&amp;lt;p&amp;gt;Penelitian ini bertujuan untuk mengetahui efektivitas pelaksanaan media tes berbasis online yang telah dikembangkan dengan model pengembangan 4-D serta mengetahui kualitas tes berbasis online yang telah dikembangkan dengan pengembangan instrumen menggunakan analisis iteman. Metode yang digunakan dalam penelitian ini adalah penelitian dan pengembangan. Sampel uji coba terbatas adalah peserta didik di Sekolah Madania Makassar sebanyak 10 orang dan peserta didik kelas XI IPA 5 di SMAN 4 Makassar sebanyak 35 orang. Berdasarkan hasil penelitian menunjukkan bahwa respon peserta didik dan guru terhadap pelaksanaan media tes berbasis online berada di kategori baik dan sangat baik sedangkan respon guru terhadap pelaksanaan media tes berbasis online berada di kategori sangat baik. Instrumen tes berbasis online yang dianalisis dengan iteman menghasilkan 20 butir soal yang dinyatakan valid dari 38 butir soal.&amp;lt;strong&amp;gt; &amp;lt;/strong&amp;gt;&amp;lt;/p&amp;gt;}, number={1}, journal={Jurnal Penelitian Ilmu Pendidikan}, author={Prisuna, Bayu Fitra}, year={2020}, month={Jun.}, pages={41–51} }