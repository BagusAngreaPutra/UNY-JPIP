@article{Dowa Bili_2015, title={STUDI KOMPARASI SELF-EFFICACY GURU SD SN DAN RSBI DI DAERAH ISTIMEWA YOGYAKARTA}, volume={7}, url={https://journal.uny.ac.id/index.php/jpip/article/view/4913}, DOI={10.21831/jpipfip.v7i2.4913}, abstractNote={&amp;lt;p&amp;gt;Penelitian ini bertujuan untuk mengetahui perbedaan &amp;lt;em&amp;gt;self-efficacy&amp;lt;/em&amp;gt; guru SDSN dan SD eks RSBI di Daerah Istimewa Yogyakarta. Penelitian ini menggunakan pendekatan kuantitatif dengan jenis komparasi. Populasi yang dipilih adalah guru SDSN dan SD eks-RSBI di DIY dengan jumlah sampel sebanyak 351 guru, yaitu 248 guru SDSN dan 103 guru SD eks-RSBI. Data dikumpulkan dengan lembar skala psikologi tentang &amp;lt;em&amp;gt;self-efficacy,&amp;lt;/em&amp;gt; berdasarkan tiga dimensi Bandura. Data dianalisis secara univariat dan bivariat memakai uji-t dua sampel independen. Hasil penelitian secara umum menunjukkan bahwa &amp;lt;em&amp;gt;self-efficacy &amp;lt;/em&amp;gt;guru SD eks RSBI lebih tinggi dibanding guru SDSN dengan selisih sebesar 0,1881.Berdasarkan uji-t dua sampel independen diperoleh signifikansi perbedaan nilai &amp;lt;em&amp;gt;p-value&amp;lt;/em&amp;gt; sebesar 0,012, meskipun di masing-masing kabupaten menunjukan hasil berbeda&amp;lt;/p&amp;gt;}, number={2}, journal={Jurnal Penelitian Ilmu Pendidikan}, author={Dowa Bili, Kristoforus}, year={2015}, month={Aug.} }