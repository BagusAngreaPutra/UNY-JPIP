@article{Kurnia_Fitria_2015, title={Pemanfaatan nursery rhymes sebagai media pendidikan karakter bagi anak usia dini}, volume={8}, url={https://journal.uny.ac.id/index.php/jpip/article/view/4926}, DOI={10.21831/jpipfip.v8i1.4926}, abstractNote={Penelitian ini bertujuan mendiskripsikan penggunaan nursery rhymes untuk&amp;lt;br /&amp;gt;mengembangkan karakter anak usia dini. Penelitian ini menganalisis tiga nursery rhymes&amp;lt;br /&amp;gt;yaitu &amp;quot;A Wise Old Owl&amp;quot;, &amp;quot;Baa Baa Black Sheep&amp;quot;, dan &amp;quot;The North Wond Doth Blow&amp;quot; dengan&amp;lt;br /&amp;gt;menggunakan metode deskriptif kualitatif. Hasil penelitian menunjukkan bahwa tiga&amp;lt;br /&amp;gt;nursery rhymesini merupakan media yang efektif untuk mendidik karakter anak. Nursery&amp;lt;br /&amp;gt;rhymes ini dapat meningkatkan cinta anak didik kepada Tuhan dan ciptaannya. Metode&amp;lt;br /&amp;gt;ini juga mampu menjadikan orang yang rendah hati, hormat dan mengasihi orang lain.&amp;lt;br /&amp;gt;Selanjutnya, berdasarkan hasil penelitian ini, penggunaan nursery rhymes di kelas dapat&amp;lt;br /&amp;gt;mengembangkan karakter anak-anak usia dini}, number={1}, journal={Jurnal Penelitian Ilmu Pendidikan}, author={Kurnia, Nandy Intan and Fitria, Yunike Juniarti}, year={2015}, month={Aug.} }